# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic
ANTHROPIC_API_KEY=
# 파싱 모델 (선택). 미설정 시 claude-sonnet-5 (v6 골든 41/41 만점 · 저비용).
# 더 강한 모델로 올리려면 주석 해제. 예: PARSE_MODEL=claude-opus-4-8
# PARSE_MODEL=claude-sonnet-5

# Phase 0: 단일 사용자. 인증 없이 이 UUID로 모든 레코드를 귀속시킨다.
USER_ID=

# /api/entries 수신 인증용 공유 토큰. iOS 단축어가 Authorization: Bearer <값> 으로 보낸다.
# 길고 무작위한 값으로 생성하세요. 예: openssl rand -hex 32
INGEST_TOKEN=
