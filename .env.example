# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic
ANTHROPIC_API_KEY=
# 파싱 모델 (선택). 미설정 시 claude-sonnet-5 (v6 골든 41/41 만점 · 저비용).
# 더 강한 모델로 올리려면 주석 해제. 예: PARSE_MODEL=claude-opus-4-8
# PARSE_MODEL=claude-sonnet-5

# 사용자 식별은 env 가 아니라 app_users.ingest_token 으로 한다. (0006_multi_user)
# 각 구성원의 토큰은 DB(app_users) 에 저장한다. USER_ID / INGEST_TOKEN 환경 변수는 폐기됨.
# 토큰 생성 예: openssl rand -hex 32  → app_users.ingest_token 에 넣는다.
